[Desktop Entry]
Name=Folders
Comment=Look through and look after your files and folders
Keywords=files;file manager;folders;browse;copy;move;trash;usb;drives;network;archive;zip;rar;7z;extract;unpack;
Exec=trindle-folders %U
Icon=system-file-manager
Terminal=false
Type=Application
Categories=System;FileTools;FileManager;
MimeType=inode/directory;application/zip;application/x-7z-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lz4-compressed-tar;application/x-lzma-compressed-tar;application/x-lzip-compressed-tar;application/x-tarz;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/vnd.efi.iso;application/x-cd-image;application/x-iso9660-image;application/vnd.ms-cab-compressed;application/x-cpio;application/x-rpm;application/x-archive;application/x-lha;application/x-xar;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip;application/x-xz;application/zstd;application/x-lz4;application/x-lzma;application/x-lzip;application/x-compress;
StartupNotify=false
StartupWMClass=org.trindle.Files
