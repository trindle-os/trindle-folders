folders-act-items =
    { $n ->
        [zero] لا عناصر
        [one] عنصر واحد
        [two] عنصران
        [few] { $n } عناصر
        [many] { $n } عنصراً
       *[other] { $n } عنصر
    }

folders-act-failed =
    { $n ->
        [zero] لم تفشل أي عملية من نوع { $verb }: { $names }.
        [one] فشل { $verb } لعنصر واحد: { $names }.
        [two] فشل { $verb } لعنصرين: { $names }.
        [few] فشل { $verb } لـ{ $n } عناصر: { $names }.
        [many] فشل { $verb } لـ{ $n } عنصراً: { $names }.
       *[other] فشل { $verb } لـ{ $n } عنصر: { $names }.
    }

