

folders-diff-stopped = أُوقفت

folders-diff-copy-left = انسخ السطر الأيسر

folders-diff-copy-right = انسخ السطر الأيمن

folders-diff-same-lines =
    { $n ->
        [zero] لا أسطر متطابقة
        [one] سطر واحد متطابق
        [two] سطران متطابقان
        [few] { $n } أسطر متطابقة
        [many] { $n } سطراً متطابقاً
       *[other] { $n } سطر متطابق
    }

