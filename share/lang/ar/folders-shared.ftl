# Words Folders carries that Trindle also uses elsewhere: a refused password, the keyring, a battery charge, the More button and the password window.

common-refused-why-cancelled = لم تُعطَ كلمة مرور المسؤول
common-refused-why-wrong = لم تُقبل كلمة مرور المسؤول
common-refused-why-not-allowed = لا يُسمح لهذا الدخول بفعل ذلك مهما أُعطيت من كلمة مرور
common-refused-why-unasked = لم يكن هناك ما يطلب كلمة مرور المسؤول
common-refused-why-unclear = لم تُقبل كلمة مرور المسؤول، أو لا يُسمح لهذا الدخول بفعل ذلك
common-refused-sentence-cancelled = لم تُعطَ كلمة مرور المسؤول
common-refused-sentence-wrong = لم تُقبل كلمة مرور المسؤول
common-refused-sentence-not-allowed = لا يُسمح لهذا الدخول بفعل ذلك مهما أُعطيت من كلمة مرور
common-refused-sentence-unasked = لم يكن هناك ما يطلب كلمة مرور المسؤول
common-refused-sentence-unclear = لم تُقبل كلمة مرور المسؤول، أو لا يُسمح لهذا الدخول بفعل ذلك
common-refused-not-done-cancelled = لم يتم: لم تُعطَ كلمة مرور المسؤول.
common-refused-not-done-wrong = لم يتم: لم تُقبل كلمة مرور المسؤول.
common-refused-not-done-not-allowed = لم يتم: لا يُسمح لهذا الدخول بفعل ذلك مهما أُعطيت من كلمة مرور. اخرج ثم ادخل مرة أخرى، ثم حاول من جديد.
common-refused-not-done-unasked = لم يتم: لم يكن هناك ما يطلب كلمة مرور المسؤول. اخرج ثم ادخل مرة أخرى، ثم حاول من جديد.
common-refused-not-done-unclear = لم يتم: لم تُقبل كلمة مرور المسؤول، أو لا يُسمح لهذا الدخول بفعل ذلك. إن لم يطلبها شيء، فاخرج ثم ادخل مرة أخرى، ثم حاول من جديد.
common-refused-no-reason = لم يتم: فشلت الخطوة ولم تذكر السبب.
common-keyring-locked = سلسلة المفاتيح مقفلة. اخرج ثم ادخل مرة أخرى، أو افتح قفلها، ثم حاول من جديد.
common-keyring-missing = لا توجد سلسلة مفاتيح على هذا الحاسوب لحفظه فيها.
common-keyring-silent = لم تجب سلسلة المفاتيح في الوقت المناسب.
common-keyring-never = لم تجب سلسلة المفاتيح أبدًا.
common-keyring-turn-failed = تعذّر التواصل مع سلسلة المفاتيح ({ $why })، فلم يُطلب منها شيء.
common-keyring-waiting =
    { $action ->
        [removing] لم تجب سلسلة المفاتيح بعد، فلم يُزَل { $what } حتى الآن. إن أزالته سلسلة المفاتيح في النهاية فسيذكر هذا السطر ذلك.
       *[other] لم تجب سلسلة المفاتيح بعد، فلم يُحفَظ { $what } حتى الآن. إن حفظته سلسلة المفاتيح في النهاية فسيذكر هذا السطر ذلك.
    }
common-keyring-late-done =
    { $action ->
        [removing] أجابت سلسلة المفاتيح متأخرة: أُزيل { $what }.
       *[other] أجابت سلسلة المفاتيح متأخرة: حُفظ { $what }.
    }
common-keyring-late-never =
    { $action ->
        [removing] لم تجب سلسلة المفاتيح أبدًا، فلم يُزَل { $what }.
       *[other] لم تجب سلسلة المفاتيح أبدًا، فلم يُحفَظ { $what }.
    }
common-keyring-late-refused =
    { $action ->
        [removing] أجابت سلسلة المفاتيح متأخرة ولم تُزل { $what }: { $why }
       *[other] أجابت سلسلة المفاتيح متأخرة ولم تحفظ { $what }: { $why }
    }
common-more = المزيد
common-more-spoken = المزيد عن هذا، يفتح المساعدة
folders-volumes-no-password = لم تُعطَ كلمة مرور، فلم يتغير شيء.
folders-volumes-nothing-changed = { $reason }، فلم يتغير شيء.
folders-volumes-busy = ما زال شيء يستخدمه. أغلق النوافذ أو البرامج التي تعرض ملفاته، ثم حاول مرة أخرى.
folders-volumes-no-room = لا توجد مساحة كافية لما عليه بهذا الحجم.
folders-prompt-password = كلمة المرور
folders-prompt-unlock = فتح القفل
folders-prompt-cancel = إلغاء
folders-prompt-type-first = اكتب كلمة المرور أولًا
folders-prompt-checking = جارٍ التحقق…
folders-wallpaper-larger-4k = أكبر من 4K
folders-wallpaper-larger-screen = أكبر من شاشتك
folders-wallpaper-over-20-or-200 = أكبر من 20 MB (200 MB إن كانت متحركة)
folders-wallpaper-over-20 = أكبر من 20 MB
folders-wallpaper-over-200 = أكبر من 200 MB
folders-wallpaper-reasons-or = { $first } أو { $second }
