# Words Folders carries that Trindle also uses elsewhere: a refused password, the keyring, a battery charge, the More button and the password window.

common-refused-why-cancelled = প্রশাসকের পাসওয়ার্ড দেওয়া হয়নি
common-refused-why-wrong = প্রশাসকের পাসওয়ার্ড গ্রহণ করা হয়নি
common-refused-why-not-allowed = এই লগইনের তা করার অনুমতি নেই, যে পাসওয়ার্ডই দেওয়া হোক
common-refused-why-unasked = প্রশাসকের পাসওয়ার্ড চাওয়ার মতো কিছু ছিল না
common-refused-why-unclear = প্রশাসকের পাসওয়ার্ড গ্রহণ করা হয়নি, অথবা এই লগইনের তা করার অনুমতি নেই
common-refused-sentence-cancelled = প্রশাসকের পাসওয়ার্ড দেওয়া হয়নি
common-refused-sentence-wrong = প্রশাসকের পাসওয়ার্ড গ্রহণ করা হয়নি
common-refused-sentence-not-allowed = এই লগইনের তা করার অনুমতি নেই, যে পাসওয়ার্ডই দেওয়া হোক
common-refused-sentence-unasked = প্রশাসকের পাসওয়ার্ড চাওয়ার মতো কিছু ছিল না
common-refused-sentence-unclear = প্রশাসকের পাসওয়ার্ড গ্রহণ করা হয়নি, অথবা এই লগইনের তা করার অনুমতি নেই
common-refused-not-done-cancelled = করা হয়নি: প্রশাসকের পাসওয়ার্ড দেওয়া হয়নি।
common-refused-not-done-wrong = করা হয়নি: প্রশাসকের পাসওয়ার্ড গ্রহণ করা হয়নি।
common-refused-not-done-not-allowed = করা হয়নি: এই লগইনের তা করার অনুমতি নেই, যে পাসওয়ার্ডই দেওয়া হোক। লগ আউট করে আবার লগ ইন করুন, তারপর আবার চেষ্টা করুন।
common-refused-not-done-unasked = করা হয়নি: প্রশাসকের পাসওয়ার্ড চাওয়ার মতো কিছু ছিল না। লগ আউট করে আবার লগ ইন করুন, তারপর আবার চেষ্টা করুন।
common-refused-not-done-unclear = করা হয়নি: প্রশাসকের পাসওয়ার্ড গ্রহণ করা হয়নি, অথবা এই লগইনের তা করার অনুমতি নেই। কিছু পাসওয়ার্ড না চেয়ে থাকলে লগ আউট করে আবার লগ ইন করুন, তারপর আবার চেষ্টা করুন।
common-refused-no-reason = করা হয়নি: ধাপটি ব্যর্থ হয়েছে এবং কারণ জানায়নি।
common-keyring-locked = কিরিং তালাবদ্ধ। লগ আউট করে আবার লগ ইন করুন, অথবা এটি খুলুন, তারপর আবার চেষ্টা করুন।
common-keyring-missing = এটি রাখার মতো কোনো কিরিং এই কম্পিউটারে নেই।
common-keyring-silent = কিরিং সময়মতো সাড়া দেয়নি।
common-keyring-never = কিরিং কখনও সাড়া দেয়নি।
common-keyring-turn-failed = কিরিংয়ের সঙ্গে কাজটি করা যায়নি ({ $why }), তাই এর কাছে কিছু চাওয়া হয়নি।
common-keyring-waiting =
    { $action ->
        [removing] কিরিং এখনও সাড়া দেয়নি, তাই { $what } এখনও সরানো হয়নি। কিরিং শেষে সরালে এই লাইন তা জানাবে।
       *[other] কিরিং এখনও সাড়া দেয়নি, তাই { $what } এখনও রাখা হয়নি। কিরিং শেষে রাখলে এই লাইন তা জানাবে।
    }
common-keyring-late-done =
    { $action ->
        [removing] কিরিং দেরিতে সাড়া দিয়েছে: { $what } সরানো হয়েছে।
       *[other] কিরিং দেরিতে সাড়া দিয়েছে: { $what } রাখা হয়েছে।
    }
common-keyring-late-never =
    { $action ->
        [removing] কিরিং কখনও সাড়া দেয়নি, তাই { $what } সরানো হয়নি।
       *[other] কিরিং কখনও সাড়া দেয়নি, তাই { $what } রাখা হয়নি।
    }
common-keyring-late-refused =
    { $action ->
        [removing] কিরিং দেরিতে সাড়া দিয়েছে এবং { $what } সরায়নি: { $why }
       *[other] কিরিং দেরিতে সাড়া দিয়েছে এবং { $what } রাখেনি: { $why }
    }
