

folders-app-link-no-folder = Der andere Bereich hat keinen passenden Ordner und ist deshalb geblieben, wo er war

folders-app-link-no-folder-named = Der andere Bereich hat keinen Ordner namens { $name } und ist deshalb geblieben, wo er war

folders-app-opened-tab = { $name } in einem neuen Tab geöffnet.

folders-app-no-window = Ein neues Fenster konnte nicht geöffnet werden.

folders-app-panes-not-kept = Die Anzahl der Bereiche konnte nicht für das nächste Mal gespeichert werden.

folders-app-nothing-at = Unter { $text } gibt es nichts.

folders-app-not-started = { $name } konnte nicht gestartet werden.

folders-app-pins-not-saved = Die angehefteten Ordner konnten nicht gespeichert werden.

folders-app-pinned-already = Das ist schon an die Seitenleiste angeheftet.

folders-app-pinned-one = { $name } an die Seitenleiste angeheftet.

folders-app-pinned-many =
    { $n ->
        [one] { $n } Ordner an die Seitenleiste angeheftet.
       *[other] { $n } Ordner an die Seitenleiste angeheftet.
    }

folders-app-items =
    { $n ->
        [one] { $n } Objekt
       *[other] { $n } Objekte
    }

folders-app-dragging = { $what } wird verschoben: auf einem Ordner, dem anderen Bereich oder der Seitenleiste loslassen. Zum Kopieren Strg gedrückt halten.

folders-app-holding = { $what } wird gehalten: auf einem Ordner, einem Tab, dem anderen Bereich oder der Seitenleiste loslassen, um zu wählen, was geschehen soll.

folders-app-only-tab = Das ist der einzige Tab dieses Bereichs. Im anderen Bereich sind noch Tabs offen.

folders-app-link-not-kept = Das Verknüpfen der Bereiche konnte nicht für das nächste Mal gespeichert werden.

folders-app-view-not-kept = Die Ansicht dieses Ordners konnte nicht gespeichert werden.

folders-app-grouping-not-kept = Die Gruppierung konnte nicht für das nächste Mal gespeichert werden.
