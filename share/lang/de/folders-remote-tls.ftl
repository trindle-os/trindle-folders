

folders-remote-tls-no-roots = dieser Computer hat keine vertrauenswürdigen Zertifikate zum Abgleich

folders-remote-tls-unknown-issuer = es ist von niemandem signiert, dem dieser Computer vertraut, wie bei einem Zertifikat, das ein Server für sich selbst erstellt hat

folders-remote-tls-expired = es ist abgelaufen

folders-remote-tls-not-yet = es ist noch nicht gültig

folders-remote-tls-wrong-name = es wurde für einen anderen Namen ausgestellt

folders-remote-tls-revoked = es wurde zurückgezogen

folders-remote-tls-failed-checks = es hat die üblichen Prüfungen nicht bestanden

folders-remote-tls-setup-failed = Sichere Verbindungen konnten nicht eingerichtet werden: { $why }

folders-remote-tls-bad-name = { $host } ist kein Name, den ein Zertifikat tragen kann

folders-remote-tls-start-failed = Eine sichere Verbindung konnte nicht gestartet werden: { $why }

folders-remote-tls-stopped = Der Server hat beim Aufbau einer sicheren Verbindung nicht mehr geantwortet.

folders-remote-tls-closed = Der Server hat die Verbindung beim Aufbau einer sicheren Verbindung geschlossen.

folders-remote-tls-could-not-set-up = Eine sichere Verbindung konnte nicht aufgebaut werden: { $why }

