# Words of the Folders program itself: what it says at the foot of its window, in the panes and while items are dragged.

folders-app-link-no-folder = The other pane has no such folder, so it stayed where it was
folders-app-link-no-folder-named = The other pane has no folder called { $name }, so it stayed where it was
folders-app-opened-tab = Opened { $name } in a new tab.
folders-app-no-window = A new window could not be opened.
folders-app-panes-not-kept = How many panes show could not be kept for next time.
folders-app-nothing-at = There is nothing at { $text }.
folders-app-not-started = { $name } could not be started.
folders-app-pins-not-saved = The pinned folders could not be saved.
folders-app-pinned-already = That is pinned to the sidebar already.
folders-app-pinned-one = Pinned { $name } to the sidebar.
folders-app-pinned-many =
    { $n ->
        [one] Pinned { $n } folder to the sidebar.
       *[other] Pinned { $n } folders to the sidebar.
    }
folders-app-items =
    { $n ->
        [one] { $n } item
       *[other] { $n } items
    }
folders-app-dragging = Moving { $what }: let go on a folder, the other pane or the sidebar. Hold Ctrl to copy.
folders-app-holding = Holding { $what }: let go on a folder, a tab, the other pane or the sidebar to choose what to do.
folders-app-only-tab = This is the pane's only tab. The other pane still has tabs open.
folders-app-link-not-kept = Linking the panes could not be kept for next time.
folders-app-view-not-kept = This folder's view could not be kept.
folders-app-grouping-not-kept = The grouping could not be kept for next time.
