# The window that asks for a server password or key passphrase when a connection needs one.

## Password question (src/files/askpass.rs)

# Question shown in the password window when the connection program gave none.
folders-askpass-default-question = Type the password for this server.
# Title of the password window when a key needs its passphrase.
folders-askpass-title-passphrase = Key passphrase
# Title of the password window when a server needs its password.
folders-askpass-title-password = Server password
