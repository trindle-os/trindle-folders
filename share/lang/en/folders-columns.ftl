# Words of the List view's columns in Folders: the headings the person can choose and the page count in the Pages column.

## Columns (src/files/columns.rs)

# Heading of the size column in the Folders list view, and its name in the menu of columns to show.
folders-columns-size = Size
# Heading of the type column in the Folders list view, and its name in the menu of columns to show.
folders-columns-type = Type
# Heading of the date changed column in the Folders list view, and its name in the menu of columns to show.
folders-columns-date = Date changed
# Heading of the date made column in the Folders list view, and its name in the menu of columns to show.
folders-columns-made = Date created
# Heading of the items column in the Folders list view, and its name in the menu of columns to show.
folders-columns-items = Items
# Heading of the permissions column in the Folders list view, and its name in the menu of columns to show.
folders-columns-rights = Permissions
# Heading of the owner column in the Folders list view, and its name in the menu of columns to show.
folders-columns-owner = Owner
# Heading of the group column in the Folders list view, and its name in the menu of columns to show.
folders-columns-group = Group
# Heading of the title column in the Folders list view, and its name in the menu of columns to show.
folders-columns-title = Title
# Heading of the artist column in the Folders list view, and its name in the menu of columns to show.
folders-columns-artist = Artist
# Heading of the album column in the Folders list view, and its name in the menu of columns to show.
folders-columns-album = Album
# Heading of the track column in the Folders list view, and its name in the menu of columns to show.
folders-columns-track = Track
# Heading of the length column in the Folders list view, and its name in the menu of columns to show.
folders-columns-length = Length
# Heading of the camera column in the Folders list view, and its name in the menu of columns to show.
folders-columns-camera = Camera
# Heading of the picture size column in the Folders list view, and its name in the menu of columns to show.
folders-columns-dimensions = Picture size
# Heading of the pages column in the Folders list view, and its name in the menu of columns to show.
folders-columns-pages = Pages
# Cell of the Pages column in the Folders list view: how many pages a document has.
folders-columns-pages-count =
    { $n ->
        [one] 1 page
       *[other] { $n } pages
    }
