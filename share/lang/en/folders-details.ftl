# Folders: the part of Properties that can be changed for one file: read only and runnable switches, dates, a song's details, a photo's notes and its camera notes.

## Details (src/files/details.rs)

# Choice for which way up a photo is shown: the usual way.
folders-details-turn-upright = Upright
# Choice for which way up a photo is shown: turned to the right.
folders-details-turn-right = Turned right
# Choice for which way up a photo is shown: upside down.
folders-details-turn-down = Upside down
# Choice for which way up a photo is shown: turned to the left.
folders-details-turn-left = Turned left
# Choice for which way up a photo is shown when it is mirrored already.
folders-details-turn-mirrored = Mirrored
# Name of the photo note and box for the date it was taken.
folders-details-note-taken = Taken
# Name of the photo note and box for its description.
folders-details-note-description = Description
# Name of the photo note and box for the person who made it.
folders-details-note-artist = Artist
# Name of the photo note and box for who holds the copyright.
folders-details-note-copyright = Copyright
# Name of the song detail and box for the title.
folders-details-song-title = Title
# Name of the song detail and box for the artist.
folders-details-song-artist = Artist
# Name of the song detail and box for the album.
folders-details-song-album = Album
# Name of the song detail and box for the year.
folders-details-song-year = Year
# Name of the song detail and box for the track number.
folders-details-song-track = Track
# Name of the song detail and box for the genre.
folders-details-song-genre = Genre
# Red words in Properties when a switch could not be changed; { $error } says why.
folders-details-change-failed = Folders couldn't change that: { $error }.
# Red words in Properties when a date could not be set; { $error } says why.
folders-details-date-failed = Folders couldn't set the date: { $error }.
# Red words in Properties when a song's details could not be written; { $error } says why.
folders-details-song-failed = Folders couldn't write the song's details: { $error }.
# Red words in Properties when the date taken is not written in the form EXIF keeps.
folders-details-taken-bad = Folders couldn't read that date. Type it like this: 2026-01-02 03:04:05.
# Red words in Properties when a photo's details could not be written; { $error } says why.
folders-details-photo-failed = Folders couldn't write the photo's details: { $error }.
# Name of the switch for a file that nobody may change.
folders-details-read-only = Read only
# Tip of the read only switch.
folders-details-read-only-tip = Stop changes to it
# Name of the switch for a file that may be run as a program.
folders-details-runnable = Can be run
# Tip of the can be run switch.
folders-details-runnable-tip = Let it run as a program
# Name beside the box for when a file was last changed.
folders-details-modified = Modified
# Name beside the box for when a file was last opened.
folders-details-opened = Opened
# Tip of a date box; { $name } is Modified or Opened and { $example } is a date written as it is typed.
folders-details-date-tip = { $name }, for example { $example }
# Heading over a song's details in Properties.
folders-details-song = Song
# Tip of the button that writes the song's details into the song.
folders-details-write-song = Save the song's details
# Heading over a photo's notes in Properties.
folders-details-photo = Photo
# Tip of the box for the date a photo was taken.
folders-details-taken-tip = Date taken, for example 2026-01-02 03:04:05
# Name beside the choice of which way up a photo is shown.
folders-details-way-up = Which way up
# Tip of the choice of which way up a photo is shown.
folders-details-way-up-tip = Which way up the photo is shown
# Name of the switch that takes out where a photo was taken.
folders-details-drop-place = Remove location
# One line under that switch.
folders-details-drop-place-sub = Folders removes the location when it saves the details.
# Tip of that switch.
folders-details-drop-place-tip = Remove the photo's location
# Tip of the button that writes the photo's notes into the photo.
folders-details-write-photo = Save the photo's details
# Heading over the list of a photo's camera notes.
folders-details-camera-notes = Camera details
