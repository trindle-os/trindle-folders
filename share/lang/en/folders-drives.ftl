# Folders' sidebar list of drives plugged in: names, the eject button, and the words said while a drive is opened or put away (src/files/drives.rs).

folders-drives-name-on = { $name } on { $drive }
folders-drives-eject = Eject { $name }
folders-drives-busy = This drive is changing. Open it again when it finishes.
folders-drives-the-drive = The drive
folders-drives-taken-out = { $name } can be taken out now
folders-drives-open-failed = { $name } could not be opened: { $why }.
folders-drives-away-failed = { $name } could not be put away: { $why }.
folders-drives-unreachable = Drives cannot be reached just now.
folders-drives-opening = Opening { $name }…
folders-drives-putting-away = Putting { $name } away…
