# Words of Folders showing and installing fonts.

folders-fonts-too-large = it is too large to show
folders-fonts-unreadable = it is not a font Folders can read
folders-fonts-have-it = You have it already.
folders-fonts-install-failed = The font could not be installed: { $why }.
folders-fonts-many =
    { $n ->
        [one] 1 font
       *[other] { $n } fonts
    }
folders-fonts-doing = Installing { $what }
folders-fonts-done = Installed { $what } for you. Apps started from now on can use it.
folders-fonts-verb = installed
folders-fonts-undo = Undo installing { $what }
