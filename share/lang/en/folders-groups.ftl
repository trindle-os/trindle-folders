# Folders: the headings that group what a folder holds by kind, date or size, and the choices for them.

## Grouping (src/files/groups.rs)

# Strip choice in the top bar: show things without groups.
folders-groups-none = No groups
# Strip choice in the top bar: group things by kind.
folders-groups-kind = Kind
# Strip choice in the top bar: group things by when they were changed.
folders-groups-date = Date
# Strip choice in the top bar: group things by size.
folders-groups-size = Size
# Heading of a group in a folder's list: the group's name, then how many things are in it, such as Pictures, 14.
folders-groups-heading = { $name }, { $n }
# Group heading for things of this kind, when grouping by kind: Folders.
folders-groups-kind-folders = Folders
# Group heading for things of this kind, when grouping by kind: Documents.
folders-groups-kind-documents = Documents
# Group heading for things of this kind, when grouping by kind: Pictures.
folders-groups-kind-pictures = Pictures
# Group heading for things of this kind, when grouping by kind: Music.
folders-groups-kind-music = Music
# Group heading for things of this kind, when grouping by kind: Videos.
folders-groups-kind-videos = Videos
# Group heading for things of this kind, when grouping by kind: Archives.
folders-groups-kind-archives = Archives
# Group heading for things of this kind, when grouping by kind: Programs.
folders-groups-kind-programs = Programs
# Group heading for things of this kind, when grouping by kind: Other files.
folders-groups-kind-other-files = Other files
# Group heading for things changed in this period, when grouping by date: Today.
folders-groups-date-today = Today
# Group heading for things changed in this period, when grouping by date: Yesterday.
folders-groups-date-yesterday = Yesterday
# Group heading for things changed in this period, when grouping by date: Earlier this week.
folders-groups-date-earlier-this-week = Earlier this week
# Group heading for things changed in this period, when grouping by date: Last week.
folders-groups-date-last-week = Last week
# Group heading for things changed in this period, when grouping by date: Earlier this month.
folders-groups-date-earlier-this-month = Earlier this month
# Group heading for things changed in this period, when grouping by date: Earlier this year.
folders-groups-date-earlier-this-year = Earlier this year
# Group heading for things changed in this period, when grouping by date: Long ago.
folders-groups-date-long-ago = Older
# Group heading for folders, when grouping by size.
folders-groups-size-folders = Folders
# Group heading for files of this size, when grouping by size: Large (over 100 MB).
folders-groups-size-large-over-100-mb = Large (over 100 MB)
# Group heading for files of this size, when grouping by size: Medium (1 MB to 100 MB).
folders-groups-size-medium-1-mb-to-100-mb = Medium (1 MB to 100 MB)
# Group heading for files of this size, when grouping by size: Small (under 1 MB).
folders-groups-size-small-under-1-mb = Small (under 1 MB)
# Group heading for files of this size, when grouping by size: Empty.
folders-groups-size-empty = Empty
