# Folders' row of column headings above the file lines.

## Column headings (src/files/heading.rs)

# Heading of the name column above the file lines in Folders, and the first name the screen reader gives.
folders-heading-name = Name
# What a screen reader says for the row of column headings above the file lines; the names of the columns follow, separated by commas.
folders-heading-spoken = Column headings: { $names }
# Red words under the file lines when the widths of the columns could not be saved; the reason follows.
folders-heading-widths-not-kept = Folders couldn't save the column widths for next time: { $why }.
