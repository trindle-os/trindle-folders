# Folders' notices about taking things out of an archive and reading one (src/files/inside.rs).

folders-inside-pick-first = Pick something in the archive first.
folders-inside-only-here = Things can only be taken out of an archive into a folder on this computer.
folders-inside-unread = { $name } could not be read: { $why }.
folders-inside-refused = { $n } could not be taken out, as their names reach outside or something is in the way.
folders-inside-failed = It could not be taken out of the archive: { $why }.
