# Folders' reading and writing of tags inside songs and notes inside photos: the reasons given when a change is refused or a file is damaged (src/files/meta.rs).

folders-meta-link = this is a link
folders-meta-damaged = damaged photo notes: { $why }
folders-meta-bad-out-of-reach = a block is out of reach
folders-meta-bad-block-past-end = a block runs past the end
folders-meta-bad-no-tiff = no TIFF header
folders-meta-bad-too-big = far too big
folders-meta-bad-jpeg-parts = the JPEG's parts do not line up
folders-meta-bad-jpeg-past-end = a JPEG part runs past the end
folders-meta-bad-png-past-end = a PNG part runs past the end
folders-meta-bad-png-empty = the PNG has no picture
folders-meta-refuse-date = the date taken must look like 2026:01:02 03:04:05
folders-meta-refuse-nul = a note cannot hold a nul character
folders-meta-refuse-way-up = the way up must be 1 to 8
folders-meta-refuse-too-long = the notes are too long to fit in a JPEG
folders-meta-only-jpeg-png = Folders can change the notes only in JPEG and PNG photos
folders-meta-no-room = there is no room left
folders-meta-tag-too-big = the tag is too big
