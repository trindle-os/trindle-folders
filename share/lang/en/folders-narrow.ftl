# Words of the Folders narrowing choices (kind, size and last-changed lists beside the search box).

## Narrowing choices (src/files/narrow.rs)

# Choice in the kind list that lets anything through.
folders-narrow-kind-anything = Anything
# Choice in the kind list that shows only folders.
folders-narrow-kind-folders = Folders
# Choice in the kind list that shows only pictures.
folders-narrow-kind-pictures = Pictures
# Choice in the kind list that shows only documents.
folders-narrow-kind-documents = Documents
# Choice in the kind list that shows only music.
folders-narrow-kind-music = Music
# Choice in the kind list that shows only video.
folders-narrow-kind-video = Video
# Choice in the kind list that shows only archives such as zip files.
folders-narrow-kind-archives = Archives
# Choice in the size list that lets any size through.
folders-narrow-size-any = Any size
# Choice in the size list that shows only items over one megabyte.
folders-narrow-size-1mb = Over 1 MB
# Choice in the size list that shows only items over one hundred megabytes.
folders-narrow-size-100mb = Over 100 MB
# Choice in the size list that shows only items over one gigabyte.
folders-narrow-size-1gb = Over 1 GB
# Choice in the last-changed list that lets any time through.
folders-narrow-changed-any = Any time
# Choice in the last-changed list that shows only items changed today.
folders-narrow-changed-today = Today
# Choice in the last-changed list that shows only items changed this week.
folders-narrow-changed-week = This week
# Choice in the last-changed list that shows only items changed this month.
folders-narrow-changed-month = This month
# Choice in the last-changed list that shows only items changed this year.
folders-narrow-changed-year = This year
