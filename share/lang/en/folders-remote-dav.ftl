# Errors and notes for WebDAV servers (dav:// and davs://) in Folders.

folders-remote-dav-changed-at-removal = { $name } (left alone: it changed just before removal)
folders-remote-dav-chunk = a chunk without a size
folders-remote-dav-not-found = { $host } could not be found ({ $why })
folders-remote-dav-no-address = { $host } has no address
folders-remote-dav-is-file = { $path } is a file, not a folder.
folders-remote-dav-file-ended = The file ended before it was all sent.
folders-remote-dav-unknown-login = The server wants a kind of login Folders does not know.
folders-remote-dav-no-listing = The server does not list folders over WebDAV here.
folders-remote-dav-not-web = The server did not answer as a web server.
folders-remote-dav-full = The server is full.
folders-remote-dav-status = The server said { $status } about { $name }.
folders-remote-dav-listing-unreadable = The folder listing could not be read: { $why }
folders-remote-dav-cut-short = The file came cut short.
folders-remote-dav-not-empty = { $name } is not empty.
