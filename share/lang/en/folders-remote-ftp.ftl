# Errors and notes for FTP, FTPS and FTPES servers in Folders.

folders-remote-ftp-no-server = no server called { $host } could be found
folders-remote-ftp-turned-away = { $host } turned the connection away
folders-remote-ftp-no-answer = { $host } did not answer
folders-remote-ftp-no-way = there is no way through to { $host }
folders-remote-ftp-no-protect = The server will not protect file transfers, so nothing was sent: { $said }
folders-remote-ftp-no-welcome = The server did not welcome us: { $said }
folders-remote-ftp-no-secure = This server does not offer secure FTP. Try the address with ftp:// in front.
folders-remote-ftp-what-secure = a secure connection
folders-remote-ftp-what-login = the login
folders-remote-ftp-what-data = a data connection
folders-remote-ftp-what-binary = binary mode
folders-remote-ftp-what-home = the login folder
folders-remote-ftp-accounts = FTP accounts
folders-remote-ftp-data-failed = The server's data connection could not be opened.
folders-remote-ftp-secure-ftp = Secure FTP
folders-remote-ftp-stopped = The server stopped answering.
folders-remote-ftp-lost = The connection to the server was lost.
folders-remote-ftp-closed = The server closed the connection.
folders-remote-ftp-that-here = That, on this server,
folders-remote-ftp-could-not = The server could not do that with { $what }: { $said }
folders-remote-ftp-not-reply = not an FTP reply
