# Names and errors for phones and tablets reached over USB (MTP) in Folders.

folders-remote-mtp-phone = Phone
folders-remote-mtp-nonsense = The phone sent something that made no sense.
folders-remote-mtp-full = The phone is full.
folders-remote-mtp-the-phone = The phone
folders-remote-mtp-that-here = That, on this phone,
folders-remote-mtp-refused = The phone refused that (code { $code }).
folders-remote-mtp-not-plugged = that phone is not plugged in
folders-remote-mtp-what-phone = the phone
folders-remote-mtp-what-storage = the phone's storage
folders-remote-mtp-shorter = The file was shorter than it said it was.
folders-remote-mtp-only-storage = Files and folders can only go inside one of the phone's storages.
folders-remote-mtp-not-folder = { $name } is not a folder.
folders-remote-mtp-is-folder = { $name } is a folder.
folders-remote-mtp-not-empty = { $name } is not empty.
folders-remote-mtp-remove-storage = Removing a whole storage
folders-remote-mtp-rename-storage = Renaming a storage
folders-remote-mtp-no-storage = The phone shows no storage. Unlock it and choose File transfer, then try again.
