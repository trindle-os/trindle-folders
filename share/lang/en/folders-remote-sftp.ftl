# Errors for SFTP servers (sftp://, through the ssh program) in Folders.

folders-remote-sftp-nonsense = The server sent a message that could not be read.
folders-remote-sftp-no-ssh = The ssh program is not installed.
folders-remote-sftp-ssh-failed = ssh could not be started.
folders-remote-sftp-old = This server's old SFTP
folders-remote-sftp-lost = The connection to the server was lost.
folders-remote-sftp-that-here = That, on this server,
folders-remote-sftp-could-not = The server could not do that with { $path }.
folders-remote-sftp-could-not-said = The server could not do that with { $path }: { $said }.
folders-remote-sftp-no-key = The key { $key } is not there.
folders-remote-sftp-no-server = no server called { $host } could be found
folders-remote-sftp-turned-away = { $host } turned the connection away
folders-remote-sftp-no-answer = { $host } did not answer
folders-remote-sftp-no-way = there is no way through to { $host }
folders-remote-sftp-none-here = SFTP on this server
folders-remote-sftp-ssh-said = ssh said: { $said }
