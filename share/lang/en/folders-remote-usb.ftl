# Errors for phones and tablets reached over USB in Folders.

folders-remote-usb-denied = { $node }, the phone's USB connection
folders-remote-usb-unplugged = the phone was unplugged
folders-remote-usb-busy = The phone
folders-remote-usb-stopped = The phone stopped answering.
folders-remote-usb-refused = The phone refused that.
folders-remote-usb-part = The phone took only part of what was sent.
