# Folders: its own settings card, opened from the top bar's More menu and by Ctrl and comma.

## Settings card (src/files/settings.rs)

# Name of the Folders settings card, and the More menu's row that opens it.
folders-settings-name = Folders settings
# Red words under a setting that could not be kept, in short.
folders-settings-not-saved = Folders couldn't save this setting.
# Red words under a setting that could not be kept; { $why } says why.
folders-settings-not-saved-because = Folders couldn't save this setting because { $why }. Nothing was changed.
# Red words at the top of the settings card when the settings file cannot be read; { $why } says why.
folders-settings-not-read = Folders couldn't read its settings: { $why }. It's showing the usual settings, and you can't change them until Folders can read your saved ones.
# Note on the Drives part of the settings card when the ring is not on this computer.
folders-settings-no-ring = Opening drives as you plug them in needs Trindle's ring, which isn't on this computer.
# Choice on the settings card: the part about how Folders opens.
folders-settings-page-start = When Folders opens
# Choice on the settings card: the part about the list.
folders-settings-page-list = List
# Choice on the settings card: the part about drives.
folders-settings-page-drives = Drives
# Choice on the settings card: the part listing kept logins.
folders-settings-page-logins = Saved logins
# Note on the Kept logins part of the settings card.
folders-settings-logins-about = Folders only sends a saved login to an address you've used it with in the last 90 days.
# Note on the Kept logins part when no login is kept.
folders-settings-no-logins = No saved logins.
# Note on the Kept logins part while the keyring is being asked.
folders-settings-logins-wait = Loading saved logins…
# Choice on the settings card, under When Folders opens: Home on the left and Recent on the right.
folders-settings-start-usual = Home and Recent
# One line under that choice.
folders-settings-start-usual-sub = Home on the left, Recent on the right.
# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Where you left each pane
# One line under that choice.
folders-settings-start-last-sub = Each pane opens in the folder it was in.
# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Places you choose
# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Recent
# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Home
# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Documents
# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = Downloads
# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Pictures
# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Trash
# Name of the setting for where the left pane starts.
folders-settings-left-pane = Left pane
# Name of the setting for where the right pane starts.
folders-settings-right-pane = Right pane
# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Choose where the pane starts
# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
folders-settings-forget-failed = Folders couldn't forget the login for { $server }: { $why }
# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Choose another folder
# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Settings section
# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Changes take effect the next time Folders opens. Press F3 to show or hide the right pane.
# Choice tip for how close the rows sit.
folders-settings-density-tip = Row spacing
# Name of the setting for how close the rows sit.
folders-settings-density = Spacing
# One line under the rows setting.
folders-settings-density-sub = Applies to every view.
# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Tick boxes for selecting
# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Show file endings
# One line under the file endings setting.
folders-settings-endings-sub = When it's off, report.pdf shows as report.
# Note under the settings of the list part.
folders-settings-list-note = When endings are hidden, Folders still shows them for programs, names with two endings, and files that aren't what their ending says. With tick boxes on, the box in the Name heading selects everything or nothing.
# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.
# Tip of the red button that lets a kept login go; { $server } is the computer.
folders-settings-forget = Forget { $server }
# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Open drives when plugged in
# One line under the drives setting.
folders-settings-drives-sub = For USB drives.
# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = Either way, the drive appears in the sidebar and the ring shows that it's there.
# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Shares
# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Reconnect shares when you log in
# One line under the reconnect setting: why it is off until chosen and what it costs.
folders-settings-reconnect-sub = Off at first, because connecting a share needs the administrator's password each time. Shares that need a login connect only when you press Reconnect.
