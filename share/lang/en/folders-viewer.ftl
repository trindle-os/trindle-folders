# Said in the viewer and preview panel in place of a picture that could not be read.
folders-viewer-picture-unread = Folders couldn't read this picture.
# Said in the viewer and preview panel in place of a file that is no longer there.
folders-viewer-gone = This file isn't there any more.
# Said in the viewer and preview panel in place of a file the person may not read.
folders-viewer-denied = You don't have permission to read this file.
# Said in the viewer and preview panel in place of a file that could not be read; why is the system's own reason.
folders-viewer-read-failed = Folders couldn't read this file: { $why }.
