

folders-app-link-no-folder = El otro panel no tiene esa carpeta, así que se quedó donde estaba

folders-app-link-no-folder-named = El otro panel no tiene ninguna carpeta llamada { $name }, así que se quedó donde estaba

folders-app-opened-tab = Se abrió { $name } en una pestaña nueva.

folders-app-no-window = No se pudo abrir una ventana nueva.

folders-app-panes-not-kept = No se pudo guardar cuántos paneles se muestran para la próxima vez.

folders-app-nothing-at = No hay nada en { $text }.

folders-app-not-started = No se pudo iniciar { $name }.

folders-app-pins-not-saved = No se pudieron guardar las carpetas fijadas.

folders-app-pinned-already = Eso ya está fijado en la barra lateral.

folders-app-pinned-one = Se fijó { $name } en la barra lateral.

folders-app-pinned-many =
    { $n ->
        [one] Se fijó { $n } carpeta en la barra lateral.
       *[other] Se fijaron { $n } carpetas en la barra lateral.
       [many] Se fijaron { $n } carpetas en la barra lateral.
    }

folders-app-items =
    { $n ->
        [one] { $n } elemento
       *[other] { $n } elementos
       [many] { $n } elementos
    }

folders-app-dragging = Moviendo { $what }: suelta sobre una carpeta, el otro panel o la barra lateral. Mantén Ctrl para copiar.

folders-app-holding = Sujetando { $what }: suelta sobre una carpeta, una pestaña, el otro panel o la barra lateral para elegir qué hacer.

folders-app-only-tab = Esta es la única pestaña del panel. El otro panel aún tiene pestañas abiertas.

folders-app-link-not-kept = No se pudo guardar el enlace entre paneles para la próxima vez.

folders-app-view-not-kept = No se pudo guardar la vista de esta carpeta.

folders-app-grouping-not-kept = No se pudo guardar la agrupación para la próxima vez.

