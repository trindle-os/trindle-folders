

folders-pair-differing =
    { $n ->
        [0] Nada aquí se diferencia del otro panel por nombre, tamaño o fecha. Las carpetas se emparejan solo por nombre.
        [one] 1 elemento de aquí no está en el otro panel o se diferencia por tamaño o fecha. Las carpetas se emparejan solo por nombre.
        [many] { $n } elementos de aquí no están en el otro panel o se diferencian por tamaño o fecha. Las carpetas se emparejan solo por nombre.
       *[other] { $n } elementos de aquí no están en el otro panel o se diferencian por tamaño o fecha. Las carpetas se emparejan solo por nombre.
    }

folders-pair-needs-both = Esto necesita los dos paneles: pulsa F3 para la vista doble.

folders-pair-no-search = Lo que ha encontrado una búsqueda no se puede mostrar en el otro panel.

