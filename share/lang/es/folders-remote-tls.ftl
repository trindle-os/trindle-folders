

folders-remote-tls-no-roots = este equipo no tiene certificados de confianza con los que comprobarlo

folders-remote-tls-unknown-issuer = no está firmado por nadie en quien confíe este equipo, como ocurre con uno que un servidor crea para sí mismo

folders-remote-tls-expired = ha caducado

folders-remote-tls-not-yet = todavía no es válido

folders-remote-tls-wrong-name = se creó para un nombre distinto

folders-remote-tls-revoked = ha sido revocado

folders-remote-tls-failed-checks = no superó las comprobaciones habituales

folders-remote-tls-setup-failed = No se pudieron configurar las conexiones seguras: { $why }

folders-remote-tls-bad-name = { $host } no es un nombre que un certificado pueda llevar

folders-remote-tls-start-failed = No se pudo iniciar una conexión segura: { $why }

folders-remote-tls-stopped = El servidor dejó de responder mientras se configuraba una conexión segura.

folders-remote-tls-closed = El servidor cerró la conexión mientras se configuraba una conexión segura.

folders-remote-tls-could-not-set-up = No se pudo configurar una conexión segura: { $why }

