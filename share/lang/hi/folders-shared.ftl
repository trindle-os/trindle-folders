# Words Folders carries that Trindle also uses elsewhere: a refused password, the keyring, a battery charge, the More button and the password window.

common-refused-why-cancelled = प्रशासक का पासवर्ड नहीं दिया गया
common-refused-why-wrong = प्रशासक का पासवर्ड स्वीकार नहीं किया गया
common-refused-why-not-allowed = इस लॉगिन को यह करने की अनुमति नहीं है, चाहे कोई भी पासवर्ड दिया जाए
common-refused-why-unasked = प्रशासक का पासवर्ड माँगने वाला कोई मौजूद नहीं था
common-refused-why-unclear = प्रशासक का पासवर्ड स्वीकार नहीं किया गया, या इस लॉगिन को यह करने की अनुमति नहीं है
common-refused-sentence-cancelled = प्रशासक का पासवर्ड नहीं दिया गया
common-refused-sentence-wrong = प्रशासक का पासवर्ड स्वीकार नहीं किया गया
common-refused-sentence-not-allowed = इस लॉगिन को यह करने की अनुमति नहीं है, चाहे कोई भी पासवर्ड दिया जाए
common-refused-sentence-unasked = प्रशासक का पासवर्ड माँगने वाला कोई मौजूद नहीं था
common-refused-sentence-unclear = प्रशासक का पासवर्ड स्वीकार नहीं किया गया, या इस लॉगिन को यह करने की अनुमति नहीं है
common-refused-not-done-cancelled = नहीं हुआ: प्रशासक का पासवर्ड नहीं दिया गया।
common-refused-not-done-wrong = नहीं हुआ: प्रशासक का पासवर्ड स्वीकार नहीं किया गया।
common-refused-not-done-not-allowed = नहीं हुआ: इस लॉगिन को यह करने की अनुमति नहीं है, चाहे कोई भी पासवर्ड दिया जाए। लॉग आउट करके फिर लॉग इन करें, फिर दोबारा कोशिश करें।
common-refused-not-done-unasked = नहीं हुआ: प्रशासक का पासवर्ड माँगने वाला कोई मौजूद नहीं था। लॉग आउट करके फिर लॉग इन करें, फिर दोबारा कोशिश करें।
common-refused-not-done-unclear = नहीं हुआ: प्रशासक का पासवर्ड स्वीकार नहीं किया गया, या इस लॉगिन को यह करने की अनुमति नहीं है। अगर किसी ने पासवर्ड नहीं माँगा, तो लॉग आउट करके फिर लॉग इन करें, फिर दोबारा कोशिश करें।
common-refused-no-reason = नहीं हुआ: यह चरण विफल रहा और कारण नहीं बताया।
common-keyring-locked = कीरिंग बंद है। लॉग आउट करके फिर लॉग इन करें, या उसे खोलें, फिर दोबारा कोशिश करें।
common-keyring-missing = इस कंप्यूटर पर इसे रखने के लिए कोई कीरिंग नहीं है।
common-keyring-silent = कीरिंग ने समय पर जवाब नहीं दिया।
common-keyring-never = कीरिंग ने कभी जवाब नहीं दिया।
common-keyring-turn-failed = कीरिंग के साथ बारी नहीं ली जा सकी ({ $why }), इसलिए उससे कुछ नहीं माँगा गया।
common-keyring-waiting =
    { $action ->
        [removing] कीरिंग ने अभी जवाब नहीं दिया, इसलिए { $what } अभी तक नहीं हटाया गया है। अगर कीरिंग बाद में उसे हटा देती है, तो यह पंक्ति बता देगी।
       *[other] कीरिंग ने अभी जवाब नहीं दिया, इसलिए { $what } अभी तक नहीं रखा गया है। अगर कीरिंग बाद में उसे रख लेती है, तो यह पंक्ति बता देगी।
    }
common-keyring-late-done =
    { $action ->
        [removing] कीरिंग ने देर से जवाब दिया: { $what } हटा दिया गया है।
       *[other] कीरिंग ने देर से जवाब दिया: { $what } रख लिया गया है।
    }
common-keyring-late-never =
    { $action ->
        [removing] कीरिंग ने कभी जवाब नहीं दिया, इसलिए { $what } नहीं हटाया गया।
       *[other] कीरिंग ने कभी जवाब नहीं दिया, इसलिए { $what } नहीं रखा गया।
    }
common-keyring-late-refused =
    { $action ->
        [removing] कीरिंग ने देर से जवाब दिया और { $what } नहीं हटाया: { $why }
       *[other] कीरिंग ने देर से जवाब दिया और { $what } नहीं रखा: { $why }
    }
common-more = और
common-more-spoken = इसके बारे में और जानें, सहायता खोलता है
folders-volumes-no-password = पासवर्ड नहीं दिया गया, इसलिए कुछ नहीं बदला।
folders-volumes-nothing-changed = { $reason }, इसलिए कुछ नहीं बदला।
folders-volumes-busy = अब भी कोई चीज़ इसे इस्तेमाल कर रही है। इसकी फ़ाइलें दिखाने वाली विंडो या प्रोग्राम बंद करें, फिर कोशिश करें।
folders-volumes-no-room = इस आकार पर इसमें जो कुछ है उसके लिए पर्याप्त जगह नहीं है।
folders-prompt-password = पासवर्ड
folders-prompt-unlock = अनलॉक करें
folders-prompt-cancel = रद्द करें
folders-prompt-type-first = पहले पासवर्ड लिखें
folders-prompt-checking = जाँच हो रही है…
folders-wallpaper-larger-4k = 4K से बड़ी
folders-wallpaper-larger-screen = आपकी स्क्रीन से बड़ी
folders-wallpaper-over-20-or-200 = 20 MB से ऊपर (चलती हो तो 200 MB से ऊपर)
folders-wallpaper-over-20 = 20 MB से ऊपर
folders-wallpaper-over-200 = 200 MB से ऊपर
folders-wallpaper-reasons-or = { $first } या { $second }
