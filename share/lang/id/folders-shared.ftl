common-refused-sentence-cancelled = Kata sandi administrator tidak diberikan
common-refused-sentence-wrong = Kata sandi administrator tidak diterima
common-refused-sentence-not-allowed = Login ini tidak diizinkan melakukan itu, kata sandi apa pun yang diberikan
common-refused-sentence-unasked = Tidak ada yang meminta kata sandi administrator
common-refused-sentence-unclear = Kata sandi administrator tidak diterima, atau login ini tidak diizinkan melakukan itu
common-refused-not-done-cancelled = Tidak dilakukan: kata sandi administrator tidak diberikan.
common-refused-not-done-wrong = Tidak dilakukan: kata sandi administrator tidak diterima.
common-refused-not-done-not-allowed = Tidak dilakukan: login ini tidak diizinkan melakukan itu, kata sandi apa pun yang diberikan. Keluar lalu masuk kembali, kemudian coba lagi.
common-refused-not-done-unasked = Tidak dilakukan: tidak ada yang meminta kata sandi administrator. Keluar lalu masuk kembali, kemudian coba lagi.
common-refused-not-done-unclear = Tidak dilakukan: kata sandi administrator tidak diterima, atau login ini tidak diizinkan melakukan itu. Jika tidak ada yang memintanya, keluar lalu masuk kembali, kemudian coba lagi.
common-refused-no-reason = Tidak dilakukan: langkah gagal dan tidak menyebut alasan.
common-keyring-locked = Gantungan kunci terkunci. Keluar lalu masuk lagi, atau buka kuncinya, kemudian coba lagi.
common-keyring-missing = Tidak ada gantungan kunci di komputer ini untuk menyimpannya.
common-keyring-silent = Gantungan kunci tidak menjawab tepat waktu.
common-keyring-never = Gantungan kunci tidak pernah menjawab.
common-keyring-turn-failed = Giliran dengan gantungan kunci tidak dapat dijalankan ({ $why }), jadi tidak ada yang diminta darinya.
common-keyring-waiting =
    { $action ->
        [removing] Gantungan kunci belum menjawab, jadi { $what } belum dihapus sejauh ini. Jika gantungan kunci akhirnya menghapusnya, baris ini akan menyatakannya.
       *[other] Gantungan kunci belum menjawab, jadi { $what } belum disimpan sejauh ini. Jika gantungan kunci akhirnya menyimpannya, baris ini akan menyatakannya.
    }
common-keyring-late-done =
    { $action ->
        [removing] Gantungan kunci menjawab terlambat: { $what } dihapus.
       *[other] Gantungan kunci menjawab terlambat: { $what } disimpan.
    }
common-keyring-late-never =
    { $action ->
        [removing] Gantungan kunci tidak pernah menjawab, jadi { $what } tidak dihapus.
       *[other] Gantungan kunci tidak pernah menjawab, jadi { $what } tidak disimpan.
    }
common-keyring-late-refused =
    { $action ->
        [removing] Gantungan kunci menjawab terlambat dan tidak menghapus { $what }: { $why }
       *[other] Gantungan kunci menjawab terlambat dan tidak menyimpan { $what }: { $why }
    }
