

folders-app-link-no-folder = O outro painel não tem essa pasta, então ficou onde estava

folders-app-link-no-folder-named = O outro painel não tem uma pasta chamada { $name }, então ficou onde estava

folders-app-opened-tab = { $name } aberto em uma nova aba.

folders-app-no-window = Não foi possível abrir uma nova janela.

folders-app-panes-not-kept = Não foi possível guardar quantos painéis aparecem para a próxima vez.

folders-app-nothing-at = Não há nada em { $text }.

folders-app-not-started = Não foi possível iniciar { $name }.

folders-app-pins-not-saved = Não foi possível salvar as pastas fixadas.

folders-app-pinned-already = Isso já está fixado na barra lateral.

folders-app-pinned-one = { $name } fixado na barra lateral.

folders-app-pinned-many =
    { $n ->
        [one] { $n } pasta fixada na barra lateral.
       *[other] { $n } pastas fixadas na barra lateral.
        [many] { $n } pastas fixadas na barra lateral.
    }

folders-app-items =
    { $n ->
        [one] { $n } item
       *[other] { $n } itens
        [many] { $n } itens
    }

folders-app-dragging = Movendo { $what }: solte em uma pasta, no outro painel ou na barra lateral. Segure Ctrl para copiar.

folders-app-holding = Segurando { $what }: solte em uma pasta, em uma aba, no outro painel ou na barra lateral para escolher o que fazer.

folders-app-only-tab = Esta é a única aba do painel. O outro painel ainda tem abas abertas.

folders-app-link-not-kept = Não foi possível guardar a ligação dos painéis para a próxima vez.

folders-app-view-not-kept = Não foi possível guardar a visualização desta pasta.

folders-app-grouping-not-kept = Não foi possível guardar o agrupamento para a próxima vez.

