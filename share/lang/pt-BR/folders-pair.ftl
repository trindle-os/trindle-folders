

folders-pair-differing =
    { $n ->
        [0] Nada aqui difere do outro painel em nome, tamanho ou data. As pastas são comparadas só pelo nome.
        [one] 1 coisa aqui não está no outro painel, ou difere dele em tamanho ou data. As pastas são comparadas só pelo nome.
       *[other] { $n } coisas aqui não estão no outro painel, ou diferem dele em tamanho ou data. As pastas são comparadas só pelo nome.
        [many] { $n } coisas aqui não estão no outro painel, ou diferem dele em tamanho ou data. As pastas são comparadas só pelo nome.
    }

folders-pair-needs-both = Isto precisa dos dois painéis: pressione F3 para a visão dupla.

folders-pair-no-search = O que uma pesquisa encontrou não pode ser mostrado no outro painel.

