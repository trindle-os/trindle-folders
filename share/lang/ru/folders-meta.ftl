

folders-meta-link = это ссылка

folders-meta-damaged = заметки фотографии повреждены: { $why }

folders-meta-bad-out-of-reach = блок находится за пределами заметок

folders-meta-bad-block-past-end = блок выходит за конец

folders-meta-bad-no-tiff = нет заголовка TIFF

folders-meta-bad-too-big = слишком большие

folders-meta-bad-jpeg-parts = части JPEG не совпадают друг с другом

folders-meta-bad-jpeg-past-end = часть JPEG выходит за конец

folders-meta-bad-png-past-end = часть PNG выходит за конец

folders-meta-bad-png-empty = в PNG нет изображения

folders-meta-refuse-date = дата съёмки должна выглядеть так: 2026:01:02 03:04:05

folders-meta-refuse-nul = заметка не может содержать нулевой символ

folders-meta-refuse-way-up = ориентация должна быть от 1 до 8

folders-meta-refuse-too-long = заметки слишком длинные для JPEG

folders-meta-only-jpeg-png = Folders может менять заметки только в фотографиях JPEG и PNG

folders-meta-no-room = не осталось места

folders-meta-tag-too-big = тег слишком большой
