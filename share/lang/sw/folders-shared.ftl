common-keyring-locked = Hifadhi ya funguo imefungwa. Toka kisha ingia tena, au ifungue, kisha jaribu tena.
common-keyring-missing = Hakuna hifadhi ya funguo kwenye kompyuta hii ya kuihifadhia.
common-keyring-silent = Hifadhi ya funguo haikujibu kwa wakati.
common-keyring-never = Hifadhi ya funguo haikujibu kamwe.
common-keyring-turn-failed = Zamu na hifadhi ya funguo haikuweza kuchukuliwa ({ $why }), kwa hiyo hakuna kilichoombwa kutoka kwake.
common-keyring-waiting =
    { $action ->
        [removing] Hifadhi ya funguo haijajibu bado, kwa hiyo { $what } haijaondolewa hadi sasa. Ikiiondoa hatimaye, mstari huu utasema hivyo.
       *[other] Hifadhi ya funguo haijajibu bado, kwa hiyo { $what } haijahifadhiwa hadi sasa. Ikiihifadhi hatimaye, mstari huu utasema hivyo.
    }
common-keyring-late-done =
    { $action ->
        [removing] Hifadhi ya funguo ilijibu kwa kuchelewa: { $what } imeondolewa.
       *[other] Hifadhi ya funguo ilijibu kwa kuchelewa: { $what } imehifadhiwa.
    }
common-keyring-late-never =
    { $action ->
        [removing] Hifadhi ya funguo haikujibu kamwe, kwa hiyo { $what } haijaondolewa.
       *[other] Hifadhi ya funguo haikujibu kamwe, kwa hiyo { $what } haijahifadhiwa.
    }
common-keyring-late-refused =
    { $action ->
        [removing] Hifadhi ya funguo ilijibu kwa kuchelewa na haikuondoa { $what }: { $why }
       *[other] Hifadhi ya funguo ilijibu kwa kuchelewa na haikuhifadhi { $what }: { $why }
    }
