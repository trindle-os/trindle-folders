

folders-pair-differing =
    { $n ->
        [0] Burada hiçbir şey diğer bölmeden ad, boyut veya tarih bakımından farklı değil. Klasörler yalnızca adlarına göre eşleştirilir.
        [one] Burada 1 öğe diğer bölmede yok ya da boyut veya tarih bakımından farklı. Klasörler yalnızca adlarına göre eşleştirilir.
       *[other] Burada { $n } öğe diğer bölmede yok ya da boyut veya tarih bakımından farklı. Klasörler yalnızca adlarına göre eşleştirilir.
    }

folders-pair-needs-both = Bunun için iki bölme de gerekir: ikili görünüm için F3 tuşuna basın.

folders-pair-no-search = Arama sonuçları diğer bölmede gösterilemez.
