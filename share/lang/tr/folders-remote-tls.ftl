

folders-remote-tls-no-roots = bu bilgisayarda onu denetleyecek güvenilir sertifika yok

folders-remote-tls-unknown-issuer = bu bilgisayarın güvendiği biri tarafından imzalanmamış, bir sunucunun kendi ürettiği sertifikalarda olduğu gibi

folders-remote-tls-expired = süresi dolmuş

folders-remote-tls-not-yet = henüz geçerli değil

folders-remote-tls-wrong-name = başka bir ad için üretilmiş

folders-remote-tls-revoked = geri çekilmiş

folders-remote-tls-failed-checks = olağan denetimlerden geçemedi

folders-remote-tls-setup-failed = Güvenli bağlantı ayarları yapılamadı: { $why }

folders-remote-tls-bad-name = { $host } bir sertifikada yer alabilecek bir ad değil

folders-remote-tls-start-failed = Güvenli bağlantı başlatılamadı: { $why }

folders-remote-tls-stopped = Sunucu, güvenli bağlantı kurulurken yanıt vermeyi bıraktı.

folders-remote-tls-closed = Sunucu, güvenli bağlantı kurulurken bağlantıyı kapattı.

folders-remote-tls-could-not-set-up = Güvenli bağlantı kurulamadı: { $why }
