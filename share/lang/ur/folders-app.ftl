

folders-app-link-no-folder = دوسرے پین میں ایسا کوئی فولڈر نہیں، اس لیے وہ اپنی جگہ پر رہا

folders-app-link-no-folder-named = دوسرے پین میں { $name } نام کا کوئی فولڈر نہیں، اس لیے وہ اپنی جگہ پر رہا

folders-app-opened-tab = { $name } نئے ٹیب میں کھول دیا گیا۔

folders-app-no-window = نئی ونڈو کھولی نہیں جا سکی۔

folders-app-panes-not-kept = پین کی تعداد اگلی بار کے لیے محفوظ نہیں ہو سکی۔

folders-app-nothing-at = { $text } پر کچھ نہیں ہے۔

folders-app-not-started = { $name } شروع نہیں ہو سکا۔

folders-app-pins-not-saved = پن کیے ہوئے فولڈرز محفوظ نہیں ہو سکے۔

folders-app-pinned-already = یہ پہلے سے سائیڈ بار میں پن ہے۔

folders-app-pinned-one = { $name } سائیڈ بار میں پن کر دیا گیا۔

folders-app-pinned-many =
    { $n ->
        [one] { $n } فولڈر سائیڈ بار میں پن کر دیا گیا۔
       *[other] { $n } فولڈرز سائیڈ بار میں پن کر دیے گئے۔
    }

folders-app-items =
    { $n ->
        [one] { $n } شے
       *[other] { $n } اشیا
    }

folders-app-dragging = { $what } کو منتقل کیا جا رہا ہے: فولڈر، دوسرے پین یا سائیڈ بار پر چھوڑیں۔ کاپی کرنے کے لیے Ctrl دبائے رکھیں۔

folders-app-holding = { $what } پکڑا ہوا ہے: کیا کرنا ہے یہ چننے کے لیے فولڈر، ٹیب، دوسرے پین یا سائیڈ بار پر چھوڑیں۔

folders-app-only-tab = یہ اس پین کا واحد ٹیب ہے۔ دوسرے پین میں ابھی ٹیب کھلے ہیں۔

folders-app-link-not-kept = پین کو جوڑنے کا انتخاب اگلی بار کے لیے محفوظ نہیں ہو سکا۔

folders-app-view-not-kept = اس فولڈر کا منظر محفوظ نہیں ہو سکا۔

folders-app-grouping-not-kept = گروپ بندی اگلی بار کے لیے محفوظ نہیں ہو سکی۔
