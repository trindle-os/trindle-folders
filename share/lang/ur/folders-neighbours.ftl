

folders-neighbours-looking = اس نیٹ ورک پر فولڈر شیئر کرنے والے کمپیوٹر تلاش کیے جا رہے ہیں۔

folders-neighbours-none = اس نیٹ ورک پر فولڈر شیئر کرنے والا کوئی کمپیوٹر نہیں ملا۔

folders-neighbours-asked =
    { $ways ->
        [both] Folders نے Windows کے طریقے سے پوچھا، اور اس طریقے سے بھی جس سے NAS، Mac یا Linux جواب دیتے ہیں۔
        [windows] Folders نے Windows کے طریقے سے پوچھا۔
       *[other] Folders نے اس طریقے سے پوچھا جس سے NAS، Mac یا Linux جواب دیتے ہیں۔
    }

folders-neighbours-no-finder = Windows کے طریقے سے نہیں پوچھا جا سکا: اس کے لیے Trindle کا تلاش کرنے والا پروگرام (trindle-wsdd) اس کمپیوٹر پر موجود نہیں۔

folders-neighbours-no-card = کوئی ایسا نیٹ ورک کارڈ جڑا ہوا نہیں جس سے پوچھا جا سکے؛ صرف VPN ایسے سوال نہیں پہنچاتا۔

folders-neighbours-refused = نیٹ ورک نے سوال قبول نہیں کیا ({ $why })۔

folders-neighbours-quiet = جو کمپیوٹر خاموش رہے، یا فائر وال کے پیچھے ہو، اسے پھر بھی اس کے نام یا پتے سے کھولا جا سکتا ہے۔
