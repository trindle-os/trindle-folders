common-keyring-locked = کی رنگ مقفل ہے۔ لاگ آؤٹ ہو کر دوبارہ لاگ ان کریں، یا اسے کھولیں، پھر کوشش کریں۔
common-keyring-missing = اس کمپیوٹر پر اسے رکھنے کے لیے کوئی کی رنگ نہیں ہے۔
common-keyring-silent = کی رنگ نے وقت پر جواب نہیں دیا۔
common-keyring-never = کی رنگ نے کبھی جواب نہیں دیا۔
common-keyring-turn-failed = کی رنگ سے رابطہ نہیں ہو سکا ({ $why })، اس لیے اس سے کچھ نہیں مانگا گیا۔
common-keyring-waiting =
    { $action ->
        [removing] کی رنگ نے ابھی جواب نہیں دیا، اس لیے { $what } اب تک ہٹایا نہیں گیا۔ اگر کی رنگ اسے بعد میں ہٹا دے تو یہ سطر بتا دے گی۔
       *[other] کی رنگ نے ابھی جواب نہیں دیا، اس لیے { $what } اب تک محفوظ نہیں ہوا۔ اگر کی رنگ اسے بعد میں محفوظ کر لے تو یہ سطر بتا دے گی۔
    }
common-keyring-late-done =
    { $action ->
        [removing] کی رنگ نے دیر سے جواب دیا: { $what } ہٹا دیا گیا۔
       *[other] کی رنگ نے دیر سے جواب دیا: { $what } محفوظ ہو گیا۔
    }
common-keyring-late-never =
    { $action ->
        [removing] کی رنگ نے کبھی جواب نہیں دیا، اس لیے { $what } ہٹایا نہیں گیا۔
       *[other] کی رنگ نے کبھی جواب نہیں دیا، اس لیے { $what } محفوظ نہیں ہوا۔
    }
common-keyring-late-refused =
    { $action ->
        [removing] کی رنگ نے دیر سے جواب دیا اور { $what } نہیں ہٹایا: { $why }
       *[other] کی رنگ نے دیر سے جواب دیا اور { $what } محفوظ نہیں کیا: { $why }
    }
