

folders-app-link-no-folder = Ngăn bên kia không có thư mục như vậy nên vẫn giữ nguyên

folders-app-link-no-folder-named = Ngăn bên kia không có thư mục tên { $name } nên vẫn giữ nguyên

folders-app-opened-tab = Đã mở { $name } trong thẻ mới.

folders-app-no-window = Không thể mở cửa sổ mới.

folders-app-panes-not-kept = Không thể lưu số ngăn hiển thị cho lần sau.

folders-app-nothing-at = Không có gì tại { $text }.

folders-app-not-started = Không thể khởi động { $name }.

folders-app-pins-not-saved = Không thể lưu các thư mục đã ghim.

folders-app-pinned-already = Mục này đã được ghim vào thanh bên.

folders-app-pinned-one = Đã ghim { $name } vào thanh bên.

folders-app-pinned-many =
    { $n ->
       *[other] Đã ghim { $n } thư mục vào thanh bên.
    }

folders-app-items =
    { $n ->
       *[other] { $n } mục
    }

folders-app-dragging = Đang di chuyển { $what }: thả vào một thư mục, ngăn bên kia hoặc thanh bên. Giữ Ctrl để sao chép.

folders-app-holding = Đang giữ { $what }: thả vào một thư mục, một thẻ, ngăn bên kia hoặc thanh bên để chọn việc cần làm.

folders-app-only-tab = Đây là thẻ duy nhất của ngăn này. Ngăn bên kia vẫn còn thẻ đang mở.

folders-app-link-not-kept = Không thể lưu việc liên kết các ngăn cho lần sau.

folders-app-view-not-kept = Không thể lưu kiểu xem của thư mục này.

folders-app-grouping-not-kept = Không thể lưu cách nhóm cho lần sau.
