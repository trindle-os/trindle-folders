

folders-remote-tls-no-roots = máy tính này không có chứng chỉ tin cậy nào để đối chiếu

folders-remote-tls-unknown-issuer = nó không được ký bởi bên nào mà máy tính này tin cậy, như thường gặp với chứng chỉ do máy chủ tự tạo

folders-remote-tls-expired = nó đã hết hạn

folders-remote-tls-not-yet = nó chưa có hiệu lực

folders-remote-tls-wrong-name = nó được tạo cho một tên khác

folders-remote-tls-revoked = nó đã bị thu hồi

folders-remote-tls-failed-checks = nó không vượt qua các bước kiểm tra thông thường

folders-remote-tls-setup-failed = Không thể thiết lập kết nối bảo mật: { $why }

folders-remote-tls-bad-name = { $host } không phải là tên mà chứng chỉ có thể mang

folders-remote-tls-start-failed = Không thể bắt đầu kết nối bảo mật: { $why }

folders-remote-tls-stopped = Máy chủ ngừng phản hồi khi đang thiết lập kết nối bảo mật.

folders-remote-tls-closed = Máy chủ đã đóng kết nối khi đang thiết lập kết nối bảo mật.

folders-remote-tls-could-not-set-up = Không thể thiết lập kết nối bảo mật: { $why }
