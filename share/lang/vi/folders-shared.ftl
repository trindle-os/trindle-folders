# Words Folders carries that Trindle also uses elsewhere: a refused password, the keyring, a battery charge, the More button and the password window.

common-refused-why-cancelled = chưa nhập mật khẩu quản trị viên
common-refused-why-wrong = mật khẩu quản trị viên không được chấp nhận
common-refused-why-not-allowed = tài khoản đăng nhập này không được phép làm việc đó, dù nhập mật khẩu nào
common-refused-why-unasked = không có gì ở đó để hỏi mật khẩu quản trị viên
common-refused-why-unclear = mật khẩu quản trị viên không được chấp nhận, hoặc tài khoản đăng nhập này không được phép làm việc đó
common-refused-sentence-cancelled = Chưa nhập mật khẩu quản trị viên
common-refused-sentence-wrong = Mật khẩu quản trị viên không được chấp nhận
common-refused-sentence-not-allowed = Tài khoản đăng nhập này không được phép làm việc đó, dù nhập mật khẩu nào
common-refused-sentence-unasked = Không có gì ở đó để hỏi mật khẩu quản trị viên
common-refused-sentence-unclear = Mật khẩu quản trị viên không được chấp nhận, hoặc tài khoản đăng nhập này không được phép làm việc đó
common-refused-not-done-cancelled = Chưa làm: chưa nhập mật khẩu quản trị viên.
common-refused-not-done-wrong = Chưa làm: mật khẩu quản trị viên không được chấp nhận.
common-refused-not-done-not-allowed = Chưa làm: tài khoản đăng nhập này không được phép làm việc đó, dù nhập mật khẩu nào. Hãy đăng xuất rồi đăng nhập lại, sau đó thử lại.
common-refused-not-done-unasked = Chưa làm: không có gì ở đó để hỏi mật khẩu quản trị viên. Hãy đăng xuất rồi đăng nhập lại, sau đó thử lại.
common-refused-not-done-unclear = Chưa làm: mật khẩu quản trị viên không được chấp nhận, hoặc tài khoản đăng nhập này không được phép làm việc đó. Nếu không có gì hỏi mật khẩu, hãy đăng xuất rồi đăng nhập lại, sau đó thử lại.
common-refused-no-reason = Chưa làm: bước này thất bại và không nêu lý do.
common-keyring-locked = Vòng khoá đang bị khoá. Hãy đăng xuất rồi đăng nhập lại, hoặc mở khoá nó, sau đó thử lại.
common-keyring-missing = Máy tính này không có vòng khoá để lưu nó.
common-keyring-silent = Vòng khoá không phản hồi kịp lúc.
common-keyring-never = Vòng khoá không bao giờ phản hồi.
common-keyring-turn-failed = Không thể gửi yêu cầu tới vòng khoá ({ $why }), nên chưa hỏi gì nó.
common-keyring-waiting =
    { $action ->
        [removing] Vòng khoá chưa phản hồi, nên cho đến giờ { $what } chưa được xoá. Nếu rốt cuộc vòng khoá xoá nó, dòng này sẽ cho biết.
       *[other] Vòng khoá chưa phản hồi, nên cho đến giờ { $what } chưa được lưu. Nếu rốt cuộc vòng khoá lưu nó, dòng này sẽ cho biết.
    }
common-keyring-late-done =
    { $action ->
        [removing] Vòng khoá phản hồi muộn: { $what } đã được xoá.
       *[other] Vòng khoá phản hồi muộn: { $what } đã được lưu.
    }
common-keyring-late-never =
    { $action ->
        [removing] Vòng khoá không bao giờ phản hồi, nên { $what } chưa được xoá.
       *[other] Vòng khoá không bao giờ phản hồi, nên { $what } chưa được lưu.
    }
common-keyring-late-refused =
    { $action ->
        [removing] Vòng khoá phản hồi muộn và không xoá { $what }: { $why }
       *[other] Vòng khoá phản hồi muộn và không lưu { $what }: { $why }
    }
common-more = Thêm
common-more-spoken = Thêm về việc này, mở Trợ giúp
folders-volumes-no-password = Chưa nhập mật khẩu, nên không có gì thay đổi.
folders-volumes-nothing-changed = { $reason }, nên không có gì thay đổi.
folders-volumes-busy = Có thứ gì đó vẫn đang dùng nó. Hãy đóng mọi cửa sổ hoặc chương trình đang hiện tệp của nó, rồi thử lại.
folders-volumes-no-room = Không đủ chỗ cho những gì đang có trên nó ở kích thước đó.
folders-prompt-password = Mật khẩu
folders-prompt-unlock = Mở khóa
folders-prompt-cancel = Hủy
folders-prompt-type-first = Hãy nhập mật khẩu trước
folders-prompt-checking = Đang kiểm tra…
folders-wallpaper-larger-4k = lớn hơn 4K
folders-wallpaper-larger-screen = lớn hơn màn hình của bạn
folders-wallpaper-over-20-or-200 = trên 20 MB (200 MB nếu là hình động)
folders-wallpaper-over-20 = trên 20 MB
folders-wallpaper-over-200 = trên 200 MB
folders-wallpaper-reasons-or = { $first } hoặc { $second }
